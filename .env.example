# Relative paths resolve from this file's directory. Environment variables override it.
PAGES_DIR=pages
DATABASE_PATH=diary.sqlite3
CHECKPOINT_PATH=checkpoint.jsonl
# Blank means the local calendar year captured at startup.
CURRENT_YEAR=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Timeout in seconds for each HTTP operation.
REQUEST_TIMEOUT=600
CONTEXT_SIZE=16384
MAX_NOTE_BYTES=12000
MAX_TAGS=10
